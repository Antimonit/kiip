# Default ignored files
/shelf/
/workspace.xml
/.idea

# Python bytecode caches, regenerated on every build
__pycache__/
*.pyc

# macOS directory metadata
.DS_Store

# jsdom, installed only to run tools/smoke.js
node_modules/

